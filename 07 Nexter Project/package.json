{
  "name": "07-nexter-project",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "server": "live-server",
    "watch:css": "sass ./assets/scss/main.scss ./assets/css/style.css -w --no-source-map",
    "compile:css": "sass ./assets/scss/main.scss ./assets/css/style.comp.css --no-source-map",
    "prefix:css": "postcss ./assets/css/style.comp.css --use autoprefixer -o ./assets/css/style.prefix.css",
    "compress:css": "sass ./assets/css/style.prefix.css ./assets/css/style.min.css --style=compressed --no-source-map",
    "start": "npm-run-all --parallel server watch:css",
    "create:css": "npm-run-all compile:css prefix:css compress:css "
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "browserslist": [
    "cover 99.5%, not dead"
  ],
  "dependencies": {
    "autoprefixer": "^10.6.1",
    "live-server": "^1.2.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "sass": "^1.106.1"
  }
}
